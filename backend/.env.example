# FinMind API 設定 (免費註冊即可取得 600 req/hr 額度；留空則使用匿名免費額度)
FINMIND_API_TOKEN=
# free: 使用 TaiwanStockPrice + TaiwanStockDividendResult 自算還原權息價
# backer: 使用 FinMind 付費版 TaiwanStockPriceAdj
FINMIND_TIER=free

# SQLite 快取路徑與 TTL (秒)
CACHE_DB_PATH=./data/tw_qvm_cache.db
CACHE_TTL_FINANCIAL_SECONDS=604800
CACHE_TTL_PRICE_SECONDS=43200
CACHE_TTL_MARKET_SNAPSHOT_SECONDS=86400

# FinMind 每小時請求節流上限
FINMIND_RATE_LIMIT_PER_HOUR=500

# CORS 允許的前端來源 (逗號分隔)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
